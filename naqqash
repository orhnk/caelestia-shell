#!/usr/bin/env bash
# naqqash — live decorator for the Caelestia Quran wallpaper widget.
# A friendly shortcut for `caelestia shell quran <fn> <args...>` (target: quran).
#
#   naqqash current                  show the current verse
#   naqqash verse 2 20 | verse 2:20  jump to a verse
#   naqqash random                   random verse
#   naqqash mode random|daily|sequential
#   naqqash font-size 1.2            scale 0.25..4 (1 = theme size)
#   naqqash font-family "Noto Naskh Arabic" | random | default
#   naqqash fonts                    list the random-rotation font pool
#   naqqash fg "#FB4934" | default   verse fill
#   naqqash fg-ref "#3C3836" | default
#   naqqash outline "#D65D0E" | default   flat verse stroke (default = spectrum gradient)
#   naqqash aura 0.8                 glow 0..3 (0 = off)
#   naqqash show                     dump all live values
#
# Instance selection: NAQQASH_IPC uses raw quickshell ipc selectors instead
# of `caelestia shell`, e.g. NAQQASH_IPC="--pid 1234" naqqash current
# (handy for test instances; default targets the real shell)

set -u

CAELESTIA_BIN="$(command -v caelestia || true)"
QS_BIN="$(command -v quickshell || echo /nix/store/j5qz914jsip1nxhnw5za98992h0bcpfy-quickshell-wrapped-0.3.1/bin/quickshell)"

# All commands are `caelestia shell quran <fn> <args...>` under the hood.
# NAQQASH_IPC overrides instance selection with raw quickshell ipc args,
# e.g. NAQQASH_IPC="--pid 1234" (used to target test instances).
call() {
    if [ -n "${NAQQASH_IPC:-}" ]; then
        if [ ! -x "$QS_BIN" ]; then
            echo "naqqash: quickshell binary not found" >&2
            exit 1
        fi
        # shellcheck disable=SC2206
        local ipc_args=(${NAQQASH_IPC})
        "$QS_BIN" ipc "${ipc_args[@]}" call quran "$@"
    else
        if [ -z "$CAELESTIA_BIN" ]; then
            echo "naqqash: caelestia binary not found" >&2
            exit 1
        fi
        "$CAELESTIA_BIN" shell quran "$@"
    fi
}

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
}

cmd="${1:-show}"
case "$cmd" in
-h | --help | help)
    usage
    ;;
current)
    call current
    ;;
verse)
    ref="${2:-}"
    if [[ "$ref" == *:* ]]; then
        call verse "${ref%%:*}" "${ref##*:}"
    elif [ $# -eq 3 ]; then
        call verse "$2" "$3"
    else
        echo "usage: naqqash verse <surah> <ayah> | naqqash verse <surah:ayah>" >&2
        exit 1
    fi
    ;;
random)
    call random
    ;;
mode)
    call mode "${2:-}"
    ;;
font-size)
    call fontSize "${2:-}"
    ;;
font-family)
    call fontFamily "${2:-default}"
    ;;
fonts)
    call fonts
    ;;
fg)
    call fg "${2:-default}"
    ;;
fg-ref)
    call fgRef "${2:-default}"
    ;;
outline)
    call outline "${2:-default}"
    ;;
aura)
    call aura "${2:-}"
    ;;
show)
    call status
    ;;
*)
    echo "naqqash: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
